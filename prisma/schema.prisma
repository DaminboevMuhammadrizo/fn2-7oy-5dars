generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  firstname String
  phone     String @unique
  password  String

  recipe Recipe[]
}

model Recipe {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  imgUrl      String
  preptime    Int
  userId      Int

  user User @relation(fields: [userId], references: [id])
}
